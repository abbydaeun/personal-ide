{
  "name": "claude-ide",
  "version": "0.1.0",
  "description": "A cozy, crayon-styled desktop IDE for Claude Code (unofficial)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "package": "node scripts/package.js",
    "install-app": "node scripts/package.js --install",
    "icon": "electron scripts/make-icon.js",
    "build:editor": "esbuild src/editor-entry.js --bundle --minify --format=iife --global-name=CM --outfile=renderer/vendor/codemirror.js",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electron/packager": "^18.4.4",
    "@electron/rebuild": "^3.7.2",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.1",
    "electron": "^33.4.11",
    "esbuild": "^0.24.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abbydaeun/personal-ide.git"
  }
}
